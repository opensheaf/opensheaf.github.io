{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-genesis-0.1.schema.json",
  "title": "OpenSheaf genesis record (genesis.json), version 0.1",
  "$comment": "Section 5 of the specification. Dedicated to the public domain under CC0 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "created",
    "nonce"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-genesis/0.1"
    },
    "kind": {
      "enum": [
        "document",
        "collection",
        "owner"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "originator": {
      "type": "string",
      "pattern": "^[a-z2-7]{52}$",
      "$comment": "section 5.3: the owner name of the owner of the first line"
    },
    "nonce": {
      "type": "string",
      "pattern": "^([0-9a-f]{2}){16,}$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]+$"
      },
      "$comment": "sections 5.1 and 6: an owner's first keys"
    },
    "threshold": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "owner"
          }
        }
      },
      "then": {
        "required": [
          "keys",
          "threshold"
        ],
        "not": {
          "required": [
            "originator"
          ]
        }
      },
      "else": {
        "required": [
          "originator"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "keys"
              ]
            },
            {
              "required": [
                "threshold"
              ]
            }
          ]
        }
      }
    }
  ]
}
