{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-genesis-0.1.schema.json",
  "title": "OpenSheaf genesis record (genesis.json), version 0.1",
  "$comment": "Proposal (section 6.5 of the specification, branches proposal/identity and proposal/owners). Dedicated to the public domain under CC0 1.0.",
  "type": "object",
  "required": [
    "format",
    "kind",
    "created",
    "nonce"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-genesis/0.1"
    },
    "kind": {
      "enum": [
        "document",
        "collection",
        "owner"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "originator": {
      "type": "string",
      "pattern": "^[a-z2-7]{52}$",
      "$comment": "proposal (section 6.5): the owner name of the owner of the first line"
    },
    "nonce": {
      "type": "string",
      "pattern": "^([0-9a-f]{2}){16,}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "owner"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "originator"
          ]
        }
      },
      "else": {
        "required": [
          "originator"
        ]
      }
    }
  ]
}
