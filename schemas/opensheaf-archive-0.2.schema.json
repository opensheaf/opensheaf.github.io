{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-archive-0.2.schema.json",
  "title": "OpenSheaf discovery document (opensheaf.json), format opensheaf-archive/0.2",
  "$comment": "Section 3.1 of the specification. Part of OpenSheaf 0.2 (https://opensheaf.org). Dedicated to the public domain under CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/",
  "type": "object",
  "required": [
    "format",
    "specification",
    "name",
    "storageRoot",
    "storageLayout",
    "owners",
    "profiles"
  ],
  "oneOf": [
    {
      "required": [
        "objects"
      ]
    },
    {
      "required": [
        "objectPages"
      ]
    }
  ],
  "properties": {
    "format": {
      "const": "opensheaf-archive/0.2"
    },
    "specification": {
      "const": "0.2"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "format": "uri"
    },
    "storageRoot": {
      "type": "string",
      "format": "uri-reference",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?/)(?!.*//)[^:?#\\\\]+/$",
      "$comment": "section 3.1: a path relative to the discovery document that stays below it, ending with / (no scheme or :, no leading /, no empty, . or .. segment)"
    },
    "storageLayout": {
      "enum": [
        "opensheaf-owner-name-storage-layout",
        "0003-hash-and-id-n-tuple-storage-layout"
      ]
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "zenodo",
          "texmacs",
          "website"
        ]
      },
      "uniqueItems": true
    },
    "feed": {
      "type": "string",
      "format": "uri"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectEntry"
      },
      "$comment": "every object of the storage root except drafts (section 3.1); or, in its place, objectPages"
    },
    "objectPages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!.*(^|/)\\.\\.?(/|$))[^?#\\\\]+\\.json$"
      },
      "$comment": "the paths, relative to the discovery document, of the pages of objects (section 3.1), each validated by opensheaf-objects-0.2.schema.json"
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "lastVersion",
          "inventorySha512",
          "date",
          "reason",
          "name",
          "owner",
          "genesisName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{51}[aq]$",
            "$comment": "the object's line (section 4), sheaf:<name>:<owner>"
          },
          "kind": {
            "enum": [
              "document",
              "collection",
              "owner"
            ]
          },
          "lastVersion": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "inventorySha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "a name of genesis.json (section 5.2): seeded SHA-256, lowercase base32, the algorithm number in the last character"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z2-7]{51}[aq]$",
            "$comment": "an owner name (section 6), the name of the owner's genesis record (52 characters of base32)"
          },
          "genesisName": {
            "type": "string",
            "pattern": "^[a-z2-7]{51}[aq]$",
            "$comment": "the genesis name, by algorithm 0 (sections 5.2, 13.3)"
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "indexes": {
      "$comment": "the indexes kept, each with the length of the prefixes of its files (sections 3.1, 12.5)",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "names": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "owners": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "sha512": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "owner",
          "catalogue"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[a-z2-7]{51}[aq]$",
            "$comment": "an owner name (section 6), the name of the owner's genesis record (52 characters of base32)"
          },
          "catalogue": {
            "type": "string",
            "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{51}[aq]$",
            "$comment": "the owner catalogue (section 8.1), sheaf:<name>:<owner>"
          }
        }
      },
      "uniqueItems": true,
      "$comment": "the owners the archive hosts (sections 3.1, 6), each with its owner catalogue (section 8.1), in the order in which the archive presents them (appendix A.3); empty for an archive that hosts no owner"
    },
    "drafts": {
      "type": "array",
      "$comment": "drafts (section 10.1) shown as unfinished work, on which nothing may rely",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "head"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sheaf:draft:[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 76,
            "$comment": "a draft's local identifier (section 10.1), sheaf:draft:<id>, <id> following the pattern of labels, at most 64 characters (76 in all)"
          },
          "kind": {
            "enum": [
              "document",
              "collection"
            ]
          },
          "head": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          }
        }
      }
    }
  },
  "$defs": {
    "objectEntry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "head",
        "inventorySha512",
        "status",
        "name",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{51}[aq]$",
          "$comment": "the object's line (section 4), sheaf:<name>:<owner>"
        },
        "kind": {
          "enum": [
            "document",
            "collection",
            "owner"
          ]
        },
        "head": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "inventorySha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z2-7]{52}$",
          "$comment": "a name of genesis.json (section 5.2): seeded SHA-256, lowercase base32, the algorithm number in the last character"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z2-7]{51}[aq]$",
          "$comment": "an owner name (section 6), the name of the owner's genesis record (52 characters of base32)"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "$comment": "a readable label (section 3.1), not an identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "owner"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          }
        }
      ]
    }
  }
}
