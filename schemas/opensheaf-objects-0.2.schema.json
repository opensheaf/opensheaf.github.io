{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-objects-0.2.schema.json",
  "title": "OpenSheaf page of objects, format opensheaf-objects/0.2",
  "$comment": "Section 3.1 of the specification: a page of the objects of an archive whose discovery document has objectPages. Part of OpenSheaf 0.2 (https://opensheaf.org). Dedicated to the public domain under CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/. The entries are those of objects in opensheaf-archive-0.2.schema.json; that every object is in exactly one page is checked by verifiers.",
  "type": "object",
  "required": [
    "format",
    "objects"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-objects/0.2"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objectEntry"
      }
    }
  },
  "$defs": {
    "objectEntry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "head",
        "inventorySha512",
        "status",
        "name",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{51}[aq]$",
          "$comment": "the object's line (section 4), sheaf:<name>:<owner>"
        },
        "kind": {
          "enum": [
            "document",
            "collection",
            "owner"
          ]
        },
        "head": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "inventorySha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z2-7]{52}$",
          "$comment": "a name of genesis.json (section 5.2): seeded SHA-256, lowercase base32, the algorithm number in the last character"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z2-7]{51}[aq]$",
          "$comment": "an owner name (section 6), the name of the owner's genesis record (52 characters of base32)"
        },
        "label": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "$comment": "a readable label (section 3.1), not an identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "owner"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          }
        }
      ]
    }
  }
}
