{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-archive-0.1.schema.json",
  "title": "OpenSheaf discovery document (opensheaf.json), format opensheaf-archive/0.1",
  "$comment": "Part of OpenSheaf 0.1 (https://opensheaf.org). Dedicated to the public domain under CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/",
  "type": "object",
  "required": [
    "format",
    "specification",
    "name",
    "storageRoot",
    "storageLayout",
    "objects",
    "profiles"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-archive/0.1"
    },
    "specification": {
      "const": "0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "format": "uri"
    },
    "storageRoot": {
      "type": "string",
      "format": "uri-reference",
      "pattern": "/$"
    },
    "storageLayout": {
      "enum": [
        "opensheaf-owner-name-storage-layout",
        "0003-hash-and-id-n-tuple-storage-layout"
      ]
    },
    "mainCollection": {
      "type": "string",
      "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$",
      "$comment": "proposal (section 6.3): the object's line, sheaf:<name>:<owner>"
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "zenodo",
          "texmacs",
          "website"
        ]
      },
      "uniqueItems": true
    },
    "replicas": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "/$"
      }
    },
    "feed": {
      "type": "string",
      "format": "uri"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "head",
          "inventorySha512",
          "status",
          "name",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$",
            "$comment": "proposal (section 6.3): the object's line, sheaf:<name>:<owner>"
          },
          "kind": {
            "enum": [
              "document",
              "collection",
              "owner"
            ]
          },
          "head": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "inventorySha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "status": {
            "enum": [
              "active",
              "withdrawn"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): a name of genesis.json: seeded SHA-256, lowercase base32, the algorithm number in the last character"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): an owner name, the name of the owner's genesis record (52 characters of base32)"
          },
          "label": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64,
            "$comment": "proposal (section 6.3): a readable label, not an identifier"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "owner"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "const": "active"
                }
              }
            }
          }
        ]
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "lastVersion",
          "inventorySha512",
          "date",
          "reason",
          "name",
          "owner",
          "genesisName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$",
            "$comment": "proposal (section 6.3): the object's line, sheaf:<name>:<owner>"
          },
          "kind": {
            "enum": [
              "document",
              "collection",
              "owner"
            ]
          },
          "lastVersion": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "inventorySha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): a name of genesis.json: seeded SHA-256, lowercase base32, the algorithm number in the last character"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): an owner name, the name of the owner's genesis record (52 characters of base32)"
          },
          "genesisName": {
            "type": "string",
            "pattern": "^[a-z2-7]{51}[aq]$",
            "$comment": "proposal (section 11.3): the name of the genesis record by algorithm 0"
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "indexes": {
      "$comment": "proposal (section 6.6): the indexes kept, each with the length of its prefix",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 2,
        "maximum": 4
      },
      "properties": {
        "names": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "owners": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "sha512": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z2-7]{52}$"
      },
      "uniqueItems": true,
      "$comment": "proposal (section 6.5): the owner names of the owners the archive hosts"
    },
    "drafts": {
      "type": "array",
      "$comment": "proposal (sections 6.1, 6.5): drafts shown as unfinished work, on which nothing may rely",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "head"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sheaf:draft:[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 76,
            "$comment": "proposal (section 6.3): a draft's local identifier, sheaf:draft:<id>, <id> following the pattern of labels, at most 64 characters (76 in all)"
          },
          "kind": {
            "enum": [
              "document",
              "collection"
            ]
          },
          "head": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
