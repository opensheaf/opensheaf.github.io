{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-archive-0.1.schema.json",
  "title": "OpenSheaf discovery document (opensheaf.json), format opensheaf-archive/0.1",
  "$comment": "Part of OpenSheaf 0.1 (https://opensheaf.org). Dedicated to the public domain under CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/",
  "type": "object",
  "required": [
    "format",
    "specification",
    "name",
    "storageRoot",
    "storageLayout",
    "objects",
    "profiles"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-archive/0.1"
    },
    "specification": {
      "const": "0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "string",
      "format": "uri"
    },
    "storageRoot": {
      "type": "string",
      "format": "uri-reference",
      "pattern": "/$"
    },
    "storageLayout": {
      "enum": [
        "opensheaf-owner-name-storage-layout",
        "0003-hash-and-id-n-tuple-storage-layout"
      ]
    },
    "mainCollection": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$"
        },
        {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        }
      ],
      "$comment": "proposal (section 6.3): the object's first line, sheaf:<name>:<owner>, or the identifier of a draft"
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "zenodo",
          "texmacs",
          "website"
        ]
      },
      "uniqueItems": true
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "/$"
      }
    },
    "feed": {
      "type": "string",
      "format": "uri"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "head",
          "inventorySha512",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$"
              },
              {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              }
            ],
            "$comment": "proposal (section 6.3): the object's first line, sheaf:<name>:<owner>, or the identifier of a draft"
          },
          "kind": {
            "enum": [
              "document",
              "collection",
              "owner"
            ]
          },
          "head": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "inventorySha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "status": {
            "enum": [
              "active",
              "withdrawn"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): a name of genesis.json: seeded SHA-256, lowercase base32, the algorithm number in the last character"
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): an owner name, the name of the owner's genesis record (52 characters of base32)"
          },
          "label": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64,
            "$comment": "proposal (section 6.3): a readable label, not an identifier"
          }
        },
        "dependentRequired": {
          "name": [
            "owner"
          ],
          "owner": [
            "name"
          ]
        }
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "lastVersion",
          "inventorySha512",
          "date",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$"
              },
              {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              }
            ],
            "$comment": "proposal (section 6.3): the object's first line, sheaf:<name>:<owner>, or the identifier of a draft"
          },
          "kind": {
            "enum": [
              "document",
              "collection",
              "owner"
            ]
          },
          "lastVersion": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          },
          "inventorySha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): a name of genesis.json: seeded SHA-256, lowercase base32, the algorithm number in the last character"
          },
          "sealed": {
            "type": "object",
            "$comment": "proposal (section 6.5): a pin of the originator's sealing version",
            "required": [
              "objectVersion",
              "inventorySha512"
            ],
            "properties": {
              "objectVersion": {
                "type": "string",
                "pattern": "^v[1-9][0-9]*$"
              },
              "inventorySha512": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              }
            }
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z2-7]{52}$",
            "$comment": "proposal (section 6.5): an owner name, the name of the owner's genesis record (52 characters of base32)"
          }
        },
        "dependentRequired": {
          "name": [
            "owner",
            "sealed"
          ],
          "owner": [
            "name"
          ],
          "sealed": [
            "name"
          ]
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "indexes": {
      "$comment": "proposal (section 6.6): the indexes kept, each with the length of its prefix",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 2,
        "maximum": 4
      },
      "properties": {
        "names": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "owners": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "sha512": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z2-7]{52}$"
      },
      "uniqueItems": true,
      "$comment": "proposal (section 6.5): the owner names of the owners the archive hosts"
    }
  }
}
