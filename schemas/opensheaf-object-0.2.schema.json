{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-object-0.2.schema.json",
  "title": "OpenSheaf object record (object.json), format opensheaf-object/0.2",
  "$comment": "Section 4.3 of the specification. Part of OpenSheaf 0.2 (https://opensheaf.org). Dedicated to the public domain under CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/",
  "type": "object",
  "required": [
    "format",
    "specification",
    "kind",
    "status"
  ],
  "properties": {
    "format": {
      "const": "opensheaf-object/0.2"
    },
    "specification": {
      "const": "0.2"
    },
    "kind": {
      "enum": [
        "document",
        "collection",
        "owner"
      ]
    },
    "documentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "mainSource": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(?:.*/)?\\.{1,2}(?:/|$))[^\\\\]+$"
    },
    "sourceFormat": {
      "type": "string",
      "minLength": 1
    },
    "sourcesMissing": {
      "$ref": "#/$defs/note"
    },
    "renditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "mediaType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(?:.*/)?\\.{1,2}(?:/|$))[^\\\\]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "changes": {
      "$ref": "#/$defs/note"
    },
    "stage": {
      "type": "object",
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/objectVersion"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/note"
          },
          {
            "type": "object",
            "required": [
              "documentVersion",
              "date"
            ],
            "properties": {
              "documentVersion": {
                "type": "integer",
                "minimum": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        ]
      }
    },
    "licence": {
      "$ref": "#/$defs/note"
    },
    "agreement": {
      "type": "object",
      "required": [
        "by",
        "date",
        "method"
      ],
      "properties": {
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "external": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "service",
          "record"
        ],
        "properties": {
          "role": {
            "enum": [
              "deposit",
              "source"
            ]
          },
          "service": {
            "type": "string"
          },
          "record": {
            "type": "string",
            "format": "uri"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.[0-9]+(\\.[0-9]+)*/\\S+$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "sha512"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sha512": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{128}$"
                },
                "md5": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "previous": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$",
      "$comment": "section 4.3: in every sealed object version from the second, the SHA-512 digest of the inventory file of the version before (its pin); absent in a first version and in a draft. Required from the second version on, which a verifier checks (section 14.2), since this file does not state its object version"
    },
    "withdrawal": {
      "type": "object",
      "required": [
        "date",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "format": "uri",
        "minLength": 1
      },
      "additionalProperties": true
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z2-7]{52}$",
      "$comment": "section 5.2: a name of genesis.json: seeded SHA-256, lowercase base32, the algorithm number in the last character"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z2-7]{51}[aq]$",
      "$comment": "section 6: an owner name, the name of the owner's genesis record (52 characters of base32)"
    },
    "parent": {
      "type": "object",
      "$comment": "section 9.1: the parent version of a branch",
      "required": [
        "owner",
        "name",
        "objectVersion",
        "documentVersion",
        "inventorySha512"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-z2-7]{51}[aq]$",
          "$comment": "section 6: an owner name, the name of the owner's genesis record (52 characters of base32)"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z2-7]{52}$",
          "$comment": "section 5.2: a name of genesis.json: seeded SHA-256, lowercase base32, the algorithm number in the last character"
        },
        "objectVersion": {
          "$ref": "#/$defs/objectVersion"
        },
        "documentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "inventorySha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "/$"
        }
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(?:.*/)?\\.{1,2}(?:/|$))[^\\\\]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ],
      "dependentRequired": {
        "path": [
          "mediaType"
        ]
      }
    },
    "objectVersion": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "document"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "mainSource",
              "sourceFormat"
            ]
          },
          {
            "required": [
              "sourcesMissing",
              "renditions"
            ],
            "properties": {
              "renditions": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        }
      },
      "then": {
        "required": [
          "withdrawal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "collection"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "mainSource"
              ]
            },
            {
              "required": [
                "sourceFormat"
              ]
            },
            {
              "required": [
                "sourcesMissing"
              ]
            },
            {
              "required": [
                "renditions"
              ]
            },
            {
              "required": [
                "toolchain"
              ]
            },
            {
              "required": [
                "changes"
              ]
            },
            {
              "required": [
                "stage"
              ]
            },
            {
              "required": [
                "history"
              ]
            },
            {
              "required": [
                "notices"
              ]
            },
            {
              "required": [
                "licence"
              ]
            }
          ]
        },
        "properties": {
          "withdrawal": {
            "properties": {
              "reason": {
                "not": {
                  "required": [
                    "path"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "sourcesMissing"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "mainSource"
              ]
            },
            {
              "required": [
                "sourceFormat"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "document",
              "collection"
            ]
          }
        }
      },
      "then": {
        "required": [
          "documentVersion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "owner"
          }
        }
      },
      "then": {
        "$comment": "section 4.3: an owner object records only format, specification, kind, name, owner and status, and optionally extensions",
        "required": [
          "name",
          "owner"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "documentVersion"
              ]
            },
            {
              "required": [
                "parent"
              ]
            },
            {
              "required": [
                "mainSource"
              ]
            },
            {
              "required": [
                "sourceFormat"
              ]
            },
            {
              "required": [
                "sourcesMissing"
              ]
            },
            {
              "required": [
                "renditions"
              ]
            },
            {
              "required": [
                "toolchain"
              ]
            },
            {
              "required": [
                "changes"
              ]
            },
            {
              "required": [
                "stage"
              ]
            },
            {
              "required": [
                "history"
              ]
            },
            {
              "required": [
                "notices"
              ]
            },
            {
              "required": [
                "withdrawal"
              ]
            },
            {
              "required": [
                "licence"
              ]
            },
            {
              "required": [
                "agreement"
              ]
            },
            {
              "required": [
                "external"
              ]
            }
          ]
        },
        "properties": {
          "status": {
            "const": "active"
          }
        }
      }
    },
    {
      "$comment": "section 4.3: a draft (no name) is never withdrawn",
      "if": {
        "not": {
          "required": [
            "name"
          ]
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      }
    }
  ],
  "dependentRequired": {
    "name": [
      "owner"
    ],
    "parent": [
      "name",
      "owner"
    ],
    "owner": [
      "name"
    ]
  }
}
