{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensheaf.org/schemas/opensheaf-index-0.1.schema.json",
  "title": "OpenSheaf index file (names/, owners/, sha512/) and index declaration (indexes.json), version 0.1",
  "$comment": "Proposal (section 6.6 of the specification, branch proposal/identity). An index file has `index` and `entries`; a declaration of indexes kept for several archives (indexes.json) has `indexes`. Dedicated to the public domain under CC0 1.0. The prefix of each entry, which must be the file's, is checked by verifiers, not by this schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/indexFile"
    },
    {
      "$ref": "#/$defs/declaration"
    }
  ],
  "$defs": {
    "indexFile": {
      "type": "object",
      "required": [
        "format",
        "index",
        "entries"
      ],
      "properties": {
        "format": {
          "const": "opensheaf-index/0.1"
        },
        "index": {
          "enum": [
            "names",
            "owners",
            "sha512"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/base32"
              },
              "originator": {
                "$ref": "#/$defs/base32",
                "$comment": "proposal (section 6.5): the owner name of the originator"
              },
              "owner": {
                "$ref": "#/$defs/base32",
                "$comment": "proposal (section 6.5): an owner name"
              },
              "names": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/base32"
                }
              },
              "genesis": {
                "type": "string",
                "$comment": "proposal (section 6.6): the exact text of genesis.json"
              },
              "inventorySha512": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              },
              "version": {
                "type": "string",
                "pattern": "^v[1-9][0-9]*$"
              },
              "status": {
                "enum": [
                  "active",
                  "withdrawn",
                  "removed"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^sheaf:[a-z2-7]{52}:[a-z2-7]{52}$",
                "$comment": "proposal (section 6.3): the object's line, sheaf:<name>:<owner>"
              },
              "label": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 64
              },
              "at": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "/$"
                },
                "$comment": "proposal (sections 6.2, 10.2): base URLs where copies may be found, all equal hints"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "index": {
                "const": "names"
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "required": [
                    "name",
                    "owner",
                    "id",
                    "status"
                  ],
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "active",
                          "withdrawn"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "originator",
                      "genesis"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "index": {
                "const": "owners"
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "required": [
                    "owner",
                    "names"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "index": {
                "const": "sha512"
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "items": {
                  "required": [
                    "inventorySha512",
                    "id",
                    "version",
                    "status"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "declaration": {
      "type": "object",
      "required": [
        "format",
        "indexes"
      ],
      "properties": {
        "format": {
          "const": "opensheaf-index/0.1"
        },
        "indexes": {
          "$ref": "#/$defs/prefixes"
        }
      },
      "not": {
        "required": [
          "entries"
        ]
      }
    },
    "prefixes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 2,
        "maximum": 4
      },
      "properties": {
        "names": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "owners": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        },
        "sha512": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4
        }
      }
    },
    "base32": {
      "type": "string",
      "pattern": "^[a-z2-7]{52}$"
    }
  }
}
